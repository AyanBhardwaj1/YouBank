# Copy to .env.local and fill in. Never commit .env.local.

# AI provider: "openai" or "anthropic". Set the matching key. Both can be present; AI_PROVIDER picks.
AI_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-6-astra"
# Cheap, fast model for one-shot web research summaries.
OPENAI_RESEARCH_MODEL="gpt-5.4-mini"

# Default reasoning depth: low | medium | high | xhigh. Users can override per run.
OPENAI_REASONING_EFFORT="medium"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"

# Financial Modeling Prep key for prices, market cap, and estimates
FMP_API_KEY=""

# Neon Postgres connection string (Dashboard > Connect, pooled)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# SEC EDGAR requires a descriptive User-Agent with a contact email
EDGAR_USER_AGENT="YouBank dev (your-email@example.com)"

# Neon Auth (managed Better Auth). Base URL from `neon env pull`; secret via `openssl rand -base64 32`
NEON_AUTH_BASE_URL=""
NEON_AUTH_COOKIE_SECRET=""

# Bearer token Vercel Cron sends to /api/cron/sync
CRON_SECRET=""

# --- Relationships: the CRM email agent ---
# Encrypts mailbox tokens at rest. Required before any mailbox can be connected.
#   openssl rand -base64 32
EMAIL_TOKEN_SECRET=""

# Google OAuth client (Google Cloud > APIs & Services > Credentials > OAuth client ID > Web
# application). Enable the Gmail API on the project, and add the callback below as an authorised
# redirect URI. Scopes used are gmail.readonly and gmail.send; Google treats both as restricted, so
# an app serving users outside your own test list needs their verification review first.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Defaults to <origin>/api/crm/gmail/callback; set it only to override.
GOOGLE_REDIRECT_URI=""

# Autopilot heartbeat. A Neon Function on a five-minute schedule (neon/autopilot.ts) calls
# /api/cron/autopilot with this bearer token. Generate with: openssl rand -base64 32
AUTOPILOT_SECRET=

# --- The site's address ---
# The one setting every domain-dependent link reads: Checkout and portal return pages, links in emails
# and Slack, team invitations, Open Graph, the sitemap and robots.txt, and the webhook URL stripe-setup
# registers. Inlined at build time, so redeploy after changing it. Locally: http://localhost:3000.
NEXT_PUBLIC_SITE_URL=""

# --- Plans and billing (Stripe) ---
# Without STRIPE_SECRET_KEY the plan page shows prices and says billing isn't switched on yet. With it,
# billing is on; set STRIPE_WEBHOOK_SECRET too, or changes made in Stripe never reach YouBank.
# `pnpm exec tsx scripts/stripe-setup.ts --webhook` creates the products, prices, webhook endpoint and
# portal configuration and prints every line below (docs/launch-billing.md).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""
STRIPE_PRICE_TEAM_MONTHLY=""
STRIPE_PRICE_TEAM_YEARLY=""
STRIPE_PRICE_ENTERPRISE_YEARLY=""
# AI credit packs; when unset a pack is sold with an inline price from src/lib/billing/packs.ts.
STRIPE_PRICE_PACK_AI10=""
STRIPE_PRICE_PACK_AI25=""
STRIPE_PRICE_PACK_AI50=""
# The customer portal configuration stripe-setup made (plan switches, seats, cancel at period end).
STRIPE_PORTAL_CONFIGURATION=""
# 1 once Stripe Tax is set up (stripe-setup --tax, plus registrations in the dashboard).
STRIPE_AUTOMATIC_TAX="0"
# 1 to require ticking the terms in Checkout; needs the terms URL saved in Stripe's public details first.
STRIPE_TERMS_CONSENT="0"
# Optional: replace every plan's AI allowance (US dollars per UTC day, per allowance month).
# AI_USER_DAILY_USD=""
# AI_USER_MONTHLY_USD=""
