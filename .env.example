# Copy to .env.local and fill in. Never commit .env.local.

# AI provider: "openai" or "anthropic". Set the matching key. Both can be present; AI_PROVIDER picks.
AI_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-6-astra"
# Cheap, fast model for one-shot web research summaries.
OPENAI_RESEARCH_MODEL="gpt-5.4-mini"

# Default reasoning depth: low | medium | high | xhigh. Users can override per run.
OPENAI_REASONING_EFFORT="medium"
ANTHROPIC_API_KEY=""

# Bot protection on sign-up and the reset-link form (src/lib/auth/bot.ts): Cloudflare Turnstile. Create a widget
# at dash.cloudflare.com → Turnstile for youbank.dev; both keys, then redeploy. Without them a honeypot still runs.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Cloudflare (all optional; docs/cloudflare.md). AI Gateway in front of every model call: the gateway's URL
# (https://gateway.ai.cloudflare.com/v1/{account}/{gateway}), or the two ids. A token only if the gateway is
# authenticated; a cache TTL (seconds) to let the gateway answer repeated structured extractions itself.
CF_AI_GATEWAY_URL=""
CF_ACCOUNT_ID=""
CF_AI_GATEWAY_ID=""
CF_AI_GATEWAY_TOKEN=""
CF_AI_GATEWAY_CACHE_TTL=""
# YouBank's Worker (cloudflare/): the Thesis Agent, the ledger sequencer, the nightly kill-criteria Workflow and
# the hosted MCP server. The secret is shared with the Worker's APP_SECRET (at least 32 characters).
CF_WORKER_URL=""
CF_WORKER_SECRET=""
# Parts to keep in the app even with the Worker set up: thesis, ledger, workflow, mcp (comma-separated) or all.
CF_DISABLE=""
ANTHROPIC_MODEL="claude-opus-5"

# Financial Modeling Prep key for prices, market cap, and estimates
FMP_API_KEY=""

# Supabase Postgres (Connect > Transaction pooler, port 6543); the session pooler (port 5432) for schema pushes
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"
DATABASE_URL_UNPOOLED="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# SEC EDGAR requires a descriptive User-Agent with a contact email
EDGAR_USER_AGENT="YouBank dev (your-email@example.com)"

# Sign-in (Better Auth, self-hosted): email and password always; secret via `openssl rand -base64 48`.
# Google is optional: an OAuth client (Web) with redirect URI <site>/api/auth/callback/google, plus
# NEXT_PUBLIC_GOOGLE_SIGNIN=1 so the buttons offer it. BETTER_AUTH_URL only for local development.
BETTER_AUTH_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_SIGNIN=""
# BETTER_AUTH_URL="http://localhost:3000"

# Bearer token Vercel Cron sends to /api/cron/sync
CRON_SECRET=""

# --- Relationships: the CRM email agent ---
# Encrypts mailbox tokens at rest. Required before any mailbox can be connected.
#   openssl rand -base64 32
EMAIL_TOKEN_SECRET=""

# Google OAuth client (Google Cloud > APIs & Services > Credentials > OAuth client ID > Web
# application). Enable the Gmail API on the project, and add the callback below as an authorised
# redirect URI. Scopes used are gmail.readonly and gmail.send; Google treats both as restricted, so
# an app serving users outside your own test list needs their verification review first.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Defaults to <origin>/api/crm/gmail/callback; set it only to override.
GOOGLE_REDIRECT_URI=""

# Calendar (docs/calendar.md). Google reuses the Gmail client above unless these are set.
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
# Microsoft 365 / Outlook.com: an Entra app registration with Calendars.ReadWrite, User.Read, offline_access.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT="common"
# Optional: "off" disables push notifications; a public tunnel for push during local work.
CALENDAR_PUSH=""
CALENDAR_PUSH_URL=""

# Autopilot heartbeat. A Neon Function on a five-minute schedule (neon/autopilot.ts) calls
# /api/cron/autopilot with this bearer token. Generate with: openssl rand -base64 32
AUTOPILOT_SECRET=

# --- The site's address ---
# The one setting every domain-dependent link reads: Checkout and portal return pages, links in emails
# and Slack, team invitations, Open Graph, the sitemap and robots.txt, and the webhook URL stripe-setup
# registers. Inlined at build time, so redeploy after changing it. Locally: http://localhost:3000.
NEXT_PUBLIC_SITE_URL=""

# --- Plans and billing (Stripe) ---
# Without STRIPE_SECRET_KEY the plan page shows prices and says billing isn't switched on yet. With it,
# billing is on; set STRIPE_WEBHOOK_SECRET too, or changes made in Stripe never reach YouBank.
# `pnpm exec tsx scripts/stripe-setup.ts --webhook` creates the products, prices, webhook endpoint and
# portal configuration and prints every line below (docs/launch-billing.md).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""
STRIPE_PRICE_TEAM_MONTHLY=""
STRIPE_PRICE_TEAM_YEARLY=""
STRIPE_PRICE_ENTERPRISE_YEARLY=""
# AI credit packs; when unset a pack is sold with an inline price from src/lib/billing/packs.ts.
STRIPE_PRICE_PACK_AI10=""
STRIPE_PRICE_PACK_AI25=""
STRIPE_PRICE_PACK_AI50=""
# The customer portal configuration stripe-setup made (plan switches, seats, cancel at period end).
STRIPE_PORTAL_CONFIGURATION=""
# 1 once Stripe Tax is set up (stripe-setup --tax, plus registrations in the dashboard).
STRIPE_AUTOMATIC_TAX="0"
# 1 to require ticking the terms in Checkout; needs the terms URL saved in Stripe's public details first.
STRIPE_TERMS_CONSENT="0"
# Optional: replace every plan's AI allowance (US dollars per UTC day, per allowance month).
# AI_USER_DAILY_USD=""
# AI_USER_MONTHLY_USD=""

# Copy trading (docs/copy-trading.md). 13F data, fund pages, backtests, paper copies and alerts need none of these.
# EDGAR requests use EDGAR_USER_AGENT above (SEC asks for a contact address in it).
# Optional: raises OpenFIGI's rate limit for CUSIP-to-ticker mapping (free key from openfigi.com).
OPENFIGI_API_KEY=""
# SnapTrade (snaptrade.com dashboard). Without both, Connect reads "Not set up yet".
SNAPTRADE_CLIENT_ID=""
SNAPTRADE_CONSUMER_KEY=""
# The SnapTrade user secret is encrypted at rest with EMAIL_TOKEN_SECRET (lib/crm/crypto), which must be set.
# Real orders are off unless this is exactly 1. Paper copies work either way. Have counsel review first.
COPYTRADE_TRADING_ENABLED="0"
# Server-wide ceilings; each copy can set lower ones.
# COPYTRADE_MAX_ORDER_USD="25000"
# COPYTRADE_MAX_DAY_USD="50000"

# --- Account recovery and migrations ---
# Forgotten passwords: every account gets a recovery key at sign-up (and can make a new one in Settings →
# Security), which resets the password at /sign-in/reset with no setup at all. Optionally, set a mail sender
# and "Forgot your password?" also offers a reset link by email:
SMTP_URL=""   # e.g. smtps://user:pass@smtp.example.com:465
MAIL_FROM=""  # e.g. "YouBank <no-reply@youbank.dev>"
# The app applies its own pending drizzle/ migrations on the first request after a deploy
# (src/lib/db/automigrate.ts). Set AUTO_MIGRATE=off to apply them only by hand (scripts/apply-sql.mts).
AUTO_MIGRATE=""
