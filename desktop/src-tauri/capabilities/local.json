{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "local",
  "description": "The app's own screens: start-up, onboarding, offline, quick ask, the desktop agent's settings and the meeting copilot's pill and window. Applies to pages bundled with the app only, never to the website.",
  "windows": [
    "main",
    "quickask",
    "agent",
    "pill",
    "copilot"
  ],
  "local": true,
  "permissions": [
    "core:event:default",
    "core:window:allow-hide",
    "core:window:allow-start-dragging",
    "allow-get-state",
    "allow-save-settings",
    "allow-accept-consent",
    "allow-site-status",
    "allow-open-site",
    "allow-open-external",
    "allow-hide-quick-ask",
    "allow-pair-start",
    "allow-pair-cancel",
    "allow-sign-out",
    "allow-refresh-account",
    "allow-ask",
    "allow-ask-cancel",
    "allow-pick-path",
    "allow-add-folder",
    "allow-remove-folder",
    "allow-set-folder-auto",
    "allow-scan-files",
    "allow-upload-files",
    "allow-remove-indexed-file",
    "allow-files-status",
    "allow-studio-docs",
    "allow-studio-pull",
    "allow-studio-push",
    "allow-studio-link",
    "allow-studio-unlink",
    "allow-studio-agent",
    "allow-office-status",
    "allow-open-local",
    "allow-run-task",
    "allow-check-alerts",
    "allow-check-update",
    "allow-install-update",
    "allow-desktop-info",
    "allow-open-quick-ask",
    "allow-open-agent",
    "allow-meeting-state",
    "allow-meeting-prompt",
    "allow-meeting-start",
    "allow-meeting-stop",
    "allow-meeting-dismiss",
    "allow-meeting-refresh",
    "allow-meeting-server-settings",
    "allow-meeting-live",
    "allow-meeting-suggest",
    "allow-meeting-brief",
    "allow-meeting-tail",
    "allow-meeting-ask",
    "allow-meeting-search",
    "allow-meeting-link",
    "allow-open-copilot",
    "allow-hide-pill"
  ]
}
