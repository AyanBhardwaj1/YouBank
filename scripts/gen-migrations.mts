/**
 * Embed drizzle/NNNN_*.sql in the app (src/lib/db/migrations.gen.ts), so a deploy can apply its own pending
 * migrations (src/lib/db/automigrate.ts) without the files being traced into the serverless bundle.
 *   pnpm exec tsx scripts/gen-migrations.mts          write it
 *   pnpm exec tsx scripts/gen-migrations.mts --check  exit 1 when it is out of date (scripts/test-prod.ts runs this)
 */
import { readdirSync, readFileSync, writeFileSync } from "node:fs";
import { execFileSync } from "node:child_process";

const OUT = "src/lib/db/migrations.gen.ts";
export function generate(): string {
  const files = readdirSync("drizzle").filter((n) => /^\d{4}_.*\.sql$/.test(n)).sort();
  const body = files.map((f) => `  [${JSON.stringify(f.replace(/\.sql$/, ""))}, ${JSON.stringify(readFileSync(`drizzle/${f}`, "utf8"))}],`).join("\n");
  // The whole schema (src/db/schema.ts) as SQL, for a database that has none yet: drizzle-kit's own export.
  const base = execFileSync("npx", ["drizzle-kit", "export", "--sql"], { encoding: "utf8", env: { ...process.env, DATABASE_URL: "", DATABASE_URL_UNPOOLED: "" }, stdio: ["ignore", "pipe", "ignore"] });
  return `// Generated by scripts/gen-migrations.mts from drizzle/*.sql and src/db/schema.ts. Do not edit; run the script after adding a migration or changing the schema.\nexport const MIGRATION_SQL: [string, string][] = [\n${body}\n];\n\n/** The schema from empty (drizzle-kit export), applied only to a database without the core tables. */\nexport const BASE_SQL: string = ${JSON.stringify(base)};\n`;
}

if (process.argv[1]?.endsWith("gen-migrations.mts")) {
  const text = generate();
  if (process.argv.includes("--check")) {
    const now = (() => { try { return readFileSync(OUT, "utf8"); } catch { return ""; } })();
    if (now !== text) { console.error(`${OUT} is out of date: run pnpm exec tsx scripts/gen-migrations.mts`); process.exit(1); }
    console.log(`${OUT} is up to date`);
  } else {
    writeFileSync(OUT, text);
    console.log(`wrote ${OUT}`);
  }
}
